{
    "router": {

        "timeout": "5s",

        "request-size": 1048576
    },

    "cookie": {

        "query-timeout": "5s",

        "session-token-expiration": "15m",

        "refresh-token-expiration": "168h"
    },

    "jwt": {

        "query-timeout": "5s",

        "jwt-token-expiration": "15m",

        "refresh-token-expiration": "720h",
        
        "special-name": "chai_auth_token"
    },

    "mfa-token-expiration": "5m",

    "verification-code-queryTimeout": "5s"
}